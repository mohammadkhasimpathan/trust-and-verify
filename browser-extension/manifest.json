{
  "manifest_version": 3,
  "name": "Trust & Verify Integration",
  "version": "1.0.0",
  "description": "Browser extension foundation for Trust & Verify Phase 11.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
